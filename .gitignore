# ====================================================================
# .gitignore - Sistema de Gestión de Turnos (Bienestar Universitario)
# ====================================================================

# --- Entornos Virtuales (Aislamiento de Dependencias) ---
.venv/
venv/
ENV/
env/
育env/

# --- Caché y Compilación de Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# --- Configuraciones del Entorno y Credenciales Secretas ---
.env
.env.local
.env.*
instance/
.secrets

# --- Archivos de Configuración del Editor (IDE) ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Archivos Temporales y de Bloqueo de Microsoft Office ---
# Ignora los archivos que empiezan con ~$ (propios de Word, Excel, etc.)
~$*
.~lock.*

# --- Sistema Operativo (Basura del Sistema) ---
.DS_Store
Thumbs.db